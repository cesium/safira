<.page title="Store" size={:xl} title_class="uppercase">
  <:actions>
    <span class="text-semibold text-xl flex place-items-center gap-2">
      <.icon name="fa-sack-dollar-solid" />
      {@current_user.attendee.tokens}
    </span>
  </:actions>
  <div class="flex justify-center w-full">
    <div
      id="products-list"
      phx-update="stream"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-6 w-full"
    >
      <%= for {id, product} <- @streams.products do %>
        <.product_card id={id} data={product} />
      <% end %>
    </div>
  </div>
</.page>
