<.page
  title="Scratch Card"
  size={:xl}
  child_class="xl:h-full xl:min-h-0 xl:overflow-hidden"
  title_class="uppercase"
  back_to_link="/app/games"
  back_to_link_text="Back to Minigames"
  back_to_link_class="text-light/50 hover:text-white mt-2 transition-colors duration-300"
>
  <:actions>
    <span class="text-semibold text-xl flex place-items-center gap-2">
      <.icon name="fa-sack-dollar-solid" />
      {@attendee_tokens}
    </span>
  </:actions>

  <section class="grid grid-cols-1 xl:grid-cols-2 gap-12 md:py-10 xl:h-full xl:min-h-0 xl:overflow-hidden xl:box-border">
    <div
      id="scratch-game"
      phx-hook="ScratchCard"
      class="flex flex-col items-center gap-8 w-full px-0 sm:px-6"
    >
      <div class="relative flex items-center justify-center rounded-3xl border border-light/10 bg-light/5 p-2 h-84 w-84">
        <%= if is_nil(assigns[:current_scratch_card]) do %>
          <div class="absolute inset-2 z-10 flex flex-col items-center justify-center rounded-2xl border border-light/10 bg-primary/80 px-6 text-center backdrop-blur-sm">
            <.icon name="fa-lock-solid" class="size-8" />
          </div>
        <% end %>

        <div
          class="bg-primary h-full w-full rounded-2xl border border-light/10 gap-8 grid grid-cols-3 p-6"
          style="background-image: repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.06) 4px, transparent 4px, transparent 10px)"
        >
          <%= if (assigns[:current_scratch_card] && assigns[:current_symbols]) do %>
            <div
              :for={symbol <- @current_symbols}
              class="flex items-center justify-center"
            >
              <img
                class="size-auto"
                src={
                  Uploaders.ScratchCardSymbols.url({symbol.image, symbol}, :original,
                    signed: true
                  )
                }
              />
            </div>
          <% end %>
        </div>

        <canvas
          id="scratch-area"
          phx-update="ignore"
          width="318"
          height="318"
          class="absolute rounded-2xl transition-opacity duration-300"
        />
      </div>

      <div class="flex flex-col gap-6 w-full items-center">
        <.action_button
          title={gettext("Give it a Scratch")}
          subtitle={"#{@scratch_card_price}"}
          subtitle_icon="sack-dollar-solid"
          disabled={
            !can_scratch?(
              @scratch_card_active?,
              @attendee_tokens,
              @scratch_card_price,
              @is_scratching?
            )
          }
          class="w-full md:w-80"
          phx-click="buy-card"
        />

        <.link
          patch={~p"/app/games/scratch_card/paytable"}
          class="flex items-center justify-center"
        >
          <.icon name="fa-coins-solid" class="text-accent mr-2" />
          <span class="text-accent font-terminal font-bold uppercase">
            {gettext("View paytable")}
          </span>
        </.link>
      </div>
    </div>

    <div class="w-full flex flex-col items-center gap-4 xl:h-full xl:min-h-0">
      <div class="flex flex-col w-full xl:flex-1 xl:min-h-0">
        <div class="inline-flex items-center gap-2 pb-2 w-full">
          <.icon name="fa-award-solid" class="size-5 text-accent" />
          <h2 class="text-lg self-start text-light/50 uppercase font-bold">
            {gettext("Latest Wins")}
          </h2>
        </div>
        <div class="w-full xl:min-h-0 xl:overflow-y-auto">
          <.latest_wins entries={@latest_wins} />
        </div>
      </div>
    </div>
  </section>
</.page>

<.result_modal
  :if={@is_revealed && @result}
  drop_type={@result.type}
  drop={@result.drop}
  wrapper_class="px-6"
  show
  id="confirm"
  on_cancel={JS.push("close-modal")}
/>

<.paytable_modal
  :if={@live_action in [:show_paytable]}
  wrapper_class="px-6 pt-8 pb-28 md:pb-0 md:pt-0"
  show
  id="paytable-modal"
  on_cancel={JS.patch(~p"/app/games/scratch_card")}
/>
